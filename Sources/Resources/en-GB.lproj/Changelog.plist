<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>4.1.0</key>
	<dict>
		<key>Summary</key>
		<string>This version adds monthly reminders, more export options, and new features for accounts, payees, and Shortcuts.</string>
		<key>Items</key>
		<array>
			<dict>
				<key>Title</key>
				<string>Monthly Reminders</string>
				<key>Description</key>
				<string>Custom reminders can now repeat monthly on selected days of the month or a specific weekday.</string>
				<key>IconName</key>
				<string>calendar.badge.clock</string>
				<key>IconColor</key>
				<string>#FF3D2F</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>Enhanced CSV Export</string>
				<key>Description</key>
				<string>CSV exports now support filters and optional attachments, bundled with an overview linking each transaction to its files.</string>
				<key>IconName</key>
				<string>arrow.up.doc</string>
				<key>IconColor</key>
				<string>#007AFF</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>Exclude Accounts from Net Worth</string>
				<key>Description</key>
				<string>Exclude individual accounts from net worth calculations while keeping them available for transactions.</string>
				<key>IconName</key>
				<string>chart.line.uptrend.xyaxis</string>
				<key>IconColor</key>
				<string>#35C759</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>Tags for Payees</string>
				<key>Description</key>
				<string>Assign tags to payees to have them automatically applied when selecting a payee in a transaction.</string>
				<key>IconName</key>
				<string>number</string>
				<key>IconColor</key>
				<string>#FF9500</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>New Shortcuts Actions</string>
				<key>Description</key>
				<string>Retrieve existing budget books, accounts, categories, folders, payees, and tags as lists in Apple Shortcuts.</string>
				<key>IconName</key>
				<string>bolt</string>
				<key>IconColor</key>
				<string>#5957D5</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
