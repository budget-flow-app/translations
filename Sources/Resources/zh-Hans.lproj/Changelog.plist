<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>4.0.0</key>
	<dict>
		<key>Summary</key>
		<string>体验全面焕新的 App，享受更出色的性能，以及备份、退款和交易管理方面的新功能。</string>
		<key>Items</key>
		<array>
			<dict>
				<key>Title</key>
				<string>全面焕新的 App</string>
				<key>Description</key>
				<string>App 采用全新架构，带来更出色的性能和全新的动画效果。</string>
				<key>IconName</key>
				<string>gauge.open.with.lines.needle.67percent.and.arrowtriangle</string>
				<key>IconColor</key>
				<string>#FF3D2F</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>改进的备份功能</string>
				<key>Description</key>
				<string>备份机制经过全面重新设计，在 Apple 设备上还可选择将数据备份至 iCloud Drive。</string>
				<key>IconName</key>
				<string>externaldrive</string>
				<key>IconColor</key>
				<string>#007AFF</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>iPhone Duo</string>
				<key>Description</key>
				<string>新增对 iPhone Duo 的支持，并针对其屏幕布局全面优化设计。</string>
				<key>IconName</key>
				<string>rectangle.split.2x1</string>
				<key>IconColor</key>
				<string>#C05AF2</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>退款</string>
				<key>Description</key>
				<string>现在可以通过轻扫手势或上下文菜单，直接从现有交易创建退款交易。</string>
				<key>IconName</key>
				<string>arrow.uturn.backward</string>
				<key>IconColor</key>
				<string>#35C759</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>收藏货币</string>
				<key>Description</key>
