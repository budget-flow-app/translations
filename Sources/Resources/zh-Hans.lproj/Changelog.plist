				<key>IconName</key>
				<string>star</string>
				<key>IconColor</key>
				<string>#FF9500</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>批量编辑</string>
				<key>Description</key>
				<string>批量编辑时，可以轻松一次选中或取消选中所有交易。此外，在共享账本中，还可以同时更改多笔交易的指定人员。</string>
				<key>IconName</key>
				<string>checklist</string>
				<key>IconColor</key>
				<string>#FF2E55</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>新增筛选选项</string>
