<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>4.1.0</key>
	<dict>
		<key>Summary</key>
		<string>此版本新增每月提醒、更多导出选项，以及账户、收款人和快捷指令的新功能。</string>
		<key>Items</key>
		<array>
			<dict>
				<key>Title</key>
				<string>每月提醒</string>
				<key>Description</key>
				<string>自定义提醒现在可以在每月选定的日期或特定星期几重复。</string>
				<key>IconName</key>
				<string>calendar.badge.clock</string>
				<key>IconColor</key>
				<string>#FF3D2F</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>增强的 CSV 导出</string>
				<key>Description</key>
				<string>CSV 导出现在支持筛选，并可选择一并导出附件，还提供概览，方便查看每笔交易对应的文件。</string>
				<key>IconName</key>
				<string>arrow.up.doc</string>
				<key>IconColor</key>
				<string>#007AFF</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>从净资产中排除账户</string>
				<key>Description</key>
				<string>将指定账户从净资产计算中排除。这些账户仍可正常用于交易。</string>
				<key>IconName</key>
				<string>chart.line.uptrend.xyaxis</string>
				<key>IconColor</key>
				<string>#35C759</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>收款人标签</string>
				<key>Description</key>
				<string>为收款人分配标签，在交易中选择该收款人时即可自动应用。</string>
				<key>IconName</key>
				<string>number</string>
				<key>IconColor</key>
				<string>#FF9500</string>
			</dict>
			<dict>
				<key>Title</key>
				<string>新的快捷指令操作</string>
				<key>Description</key>
				<string>在 Apple 快捷指令中，以列表形式获取现有的账本、账户、类别、文件夹、收款人和标签。</string>
				<key>IconName</key>
				<string>bolt</string>
				<key>IconColor</key>
				<string>#5957D5</string>
			</dict>
		</array>
	</dict>
</dict>
</plist>
